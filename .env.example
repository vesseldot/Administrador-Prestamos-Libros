# Copia este archivo como .env y ajusta los valores:   cp .env.example .env
# Nunca subas .env a git. Este archivo de ejemplo no contiene secretos.
# Lo leen tanto la aplicación como docker compose.

# ---------------- Redis ----------------
# Sirve cualquier Redis 6+ ya instalado (servicio local, WSL, Memurai, otro equipo)
# o el de docker-compose.yml (opcional). Comprueba con:  redis-cli -h HOST -p PUERTO ping
REDIS_HOST=localhost
REDIS_PORT=6379
# Base dedicada y vacía (0-15). La aplicación se niega a usar una base con llaves ajenas.
# Comprueba que esté vacía con:  redis-cli -n 2 DBSIZE   (debe responder 0)
REDIS_DB=2
# Solo si tu Redis exige autenticación (requirepass o usuarios ACL de Redis 6+).
REDIS_USUARIO=
REDIS_PASSWORD=
# 1 = conexión cifrada TLS (Redis en otro equipo o en la nube).
REDIS_SSL=0
REDIS_PREFIJO=bib:
REDIS_TIMEOUT=3
# Solo para docker compose: interfaz donde se publica Redis (127.0.0.1 = solo este equipo).
REDIS_BIND=127.0.0.1

# ---------------- ChromaDB ----------------
# Carpeta persistente del índice semántico (relativa al proyecto o absoluta).
BIBLIOTECA_CHROMA_PATH=chroma_db

# ---------------- Modelo de embeddings ----------------
# qwen3-embedding-0.6b | paraphrase-multilingual-MiniLM-L12-v2 | multilingual-e5-small
# multilingual-e5-base | sentence_similarity_spanish_es
BIBLIOTECA_MODELO=qwen3-embedding-0.6b
# Carpeta donde se descargan los modelos. Vacío = caché estándar de Hugging Face
# (~/.cache/huggingface/hub), compartida con otros proyectos. Ej.: modelos_descargados
BIBLIOTECA_DIR_MODELOS=
# 1 = la aplicación ofrece descargar el modelo si falta; 0 = nunca descarga.
BIBLIOTECA_PERMITIR_DESCARGA=1
# auto | cuda | cpu
BIBLIOTECA_DISPOSITIVO=auto
BIBLIOTECA_LOTE_EMBEDDINGS=32

# ---------------- Portadas de los libros ----------------
# Carpeta de las portadas (imágenes JPEG por id de libro). Está excluida de git.
BIBLIOTECA_DIR_PORTADAS=portadas
# 1 = permite buscar portadas en Open Library (openlibrary.org); 0 = solo imágenes elegidas a mano.
BIBLIOTECA_DESCARGAR_PORTADAS=1

# ---------------- Reglas de negocio ----------------
BIBLIOTECA_DIAS_PRESTAMO=14

# ---------------- Seguridad ----------------
# Carpeta de secretos (llave AES y hash de la contraseña). Está excluida de git.
BIBLIOTECA_DIR_SECRETOS=secrets
# Minutos de inactividad antes de bloquear la sesión del operador.
BIBLIOTECA_MINUTOS_BLOQUEO=15
# Opcional: llave AES-256 en base64 (32 bytes). Si se deja vacía se usa (o se genera)
# secrets/biblioteca_aes.key. Genera una con:  python gestionar_secretos.py nueva-llave
# Cada instalación debe tener SU PROPIA llave. Respáldala: sin ella los datos no se recuperan.
BIBLIOTECA_AES_KEY=
# Opcional: hash scrypt de la contraseña del operador. Vacío = secrets/operador.hash.
# Cámbiala con:  python gestionar_secretos.py contrasena
BIBLIOTECA_OPERADOR_HASH=
